<LotteryItemDisplayDialog xmlns="runtime-namespace:Game">
  <CanvasWidget Size="287, 382" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">
    <BevelledRectangleWidget BevelSize="3" />
    <LabelWidget CanvasWidget.Position="80, 3" Name="TitleLabel" FontScale ="1.5"/>
    <CanvasWidget CanvasWidget.Position="3, 40" Size="287, 32">
      <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" Margin="0, 2">
        <ListPanelWidget Name="IntroductionList" Direction="Vertical" Margin="5, 5" ItemSize="10" SelectionColor="107, 103, 92, 255"/>
      </StackPanelWidget>
    </CanvasWidget>
    <CanvasWidget CanvasWidget.Position="3, 80" Size="287, 192">
      <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" Margin="0, 2">
        <ListPanelWidget Name="LotteryItemsList" Direction="Vertical" Margin="5, 5" ItemSize="64" SelectionColor="107, 103, 92, 255"/>
      </StackPanelWidget>
    </CanvasWidget>
    <CanvasWidget CanvasWidget.Position="3, 282" Size="287, 192">
      <BevelledButtonWidget Style="{Styles/ButtonStyle_180x60}" HorizontalAlignment="Center" Name="IAmSureButton" Text="确定" FontScale ="1.25"/>
    </CanvasWidget>
  </CanvasWidget>
</LotteryItemDisplayDialog>