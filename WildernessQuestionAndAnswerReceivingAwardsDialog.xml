    <CanvasWidget CanvasWidget.Position="260, 3" Size="64, 64">
      <BitmapButtonWidget Name="CancelButton" Size="64, 64" VerticalAlignment="Center" HorizontalAlignment="Center" NormalSubtexture="{Textures/Gui/Button/CancelButton}" ClickedSubtexture="{Textures/Gui/Button/CancelButton_Pressed}" Margin="0, 0" />
    </CanvasWidget>
    <CanvasWidget CanvasWidget.Position="32, 74" Size="254, 127">
      <BitmapButtonWidget Name="Background" CanvasWidget.Position="0, 0" Size="254, 127" NormalSubtexture="{Textures/Gui/Activity/QuestionAndAnswerBackgroundButton}" ClickedSubtexture="{Textures/Gui/Activity/QuestionAndAnswerBackgroundButton}" Margin="0, 0" />
    </CanvasWidget>
    <CanvasWidget CanvasWidget.Position="3, 221" Size="318, 20">
      <LabelWidget Name="AnswerLogarithmsLabel" Color="255, 255, 255" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0" FontScale ="2"/>
    </CanvasWidget>
    <CanvasWidget CanvasWidget.Position="3, 300" Size="318, 64">
