    </CanvasWidget>
    <CanvasWidget CanvasWidget.Position="3, 400" Size="318, 70">
      <BevelledButtonWidget Style="{Styles/ButtonStyle_180x60}" HorizontalAlignment="Center" Name="ReceiveRewardsButton" Text="领取奖励" FontScale ="1.25"/>
    </CanvasWidget>
  </CanvasWidget>
</WildernessQuestionAndAnswerReceivingAwardsDialog>